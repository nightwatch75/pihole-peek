# pihole-peek configuration — copy to "config" next to the script and edit.
# Plain KEY="value" lines. The environment and the command line win over them.
# pihole-peek sources this file, pihole-peek.py only reads the assignments, so
# keep it to assignments: a $(command) in here runs in one and not in the other.
# Keep this file private if it holds a password:  chmod 600 config

# Base URL of the Pi-hole. The API is at URL/api.
PIHOLE_URL="http://pihole.example.lan"

# Default client. Leave it out to report every client.
#PIHOLE_CLIENT="192.0.2.70"

# Friendly name of that client, written next to its address in the html report.
#PIHOLE_ALIAS="living room TV"

# Web password or app password. Leave it out if the Pi-hole has no password.
# An app password (Settings > Web interface / API) is better than the web one.
#PIHOLE_PASSWORD="change-me"

# Defaults for --status, --hours and --format.
#PIHOLE_STATUS="all"
#PIHOLE_HOURS="24"
#PIHOLE_FORMAT="count"

# Queries per API request. The server never returns more than 10000; lower it
# to use less memory on a small box.
#PIHOLE_PAGE_SIZE="10000"

# Set to 1 to accept a self-signed TLS certificate (same as --insecure).
#PIHOLE_INSECURE="0"

# Set to 1 to show each client's DHCP/DNS name instead of its address, in the
# CLIENT column and the html report's client filter (same as --client-names).
# Falls back to the address when a client has no known name.
#PIHOLE_CLIENT_NAMES="0"
